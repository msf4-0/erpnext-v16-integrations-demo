# ---- secrets: never commit -------------------------------------------------
.env
**/.env
sandbox/.env.ai-fix
shopify-setup/.env
*.pem

# ---- generated at build time (up.ps1 step 10 rebuilds the flow) -----------
sandbox/node-red/flows.json
# backups of the flow carry the baked ERPNext + Shopify tokens
sandbox/node-red/*.bak
sandbox/node-red/*.bak.*

# ---- caches / logs --------------------------------------------------------
__pycache__/
*.pyc
*.log
.cache/
sandbox/.cache/
Thumbs.db

# ---- persistent DB datadir (bind-mounted, lives on the host disk) --------
data/

# ---- baked image artifact (large binary, not source) ----------------------
comp_demo-bench-v16.tar

# ---- frontend toolchain (only needed to recompile the SPA) ----------------
scheduler/frontend/node_modules/
scheduler/ui-tests/node_modules/
scheduler/ui-tests/*.png

# ---- agent/harness session artifacts (never commit) -----------------------
_session_extract/

# ---- ad-hoc metabase wiring scratch files (hold/read live credentials) -----
_mb_secret.txt
_mb_cfg.py
_mb_wire.sh
_mb_app.sh
_mb_app2.sh

# ---- lowdefy runtime data (rebuilt on startup, not source) ------------------
lowdefy/server/exceptions.db
# container/compose backup files
*.bak-*

