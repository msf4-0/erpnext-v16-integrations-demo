# Lowdefy + Exception Service — copy to .env (gitignored). Values are placeholders.
ERPNEXT_URL=http://localhost:8000
ERPNEXT_API_KEY=__FILL_ME__
ERPNEXT_API_SECRET=__FILL_ME__
# Full Authorization header built server-side as "token <key>:<secret>".
ERPNEXT_AUTH_HEADER=token __FILL_ME__:__FILL_ME__
EXCEPTION_URL=http://localhost:4000
EXCEPTION_PORT=4000
EXCEPTION_DB_PATH=./server/exceptions.db
LOWDEFY_PORT=3000
