# ===========================================================================
# comp_demo - stack configuration
# ===========================================================================
# Copy this file to .env and you are done for the core stack:
#     copy .env.example .env
#
# DEFAULTS BELOW BOOT WITHOUT EDITING. Optional integrations (Shopify, ngrok,
# Metabase) stay disabled while their value is blank, and every script must
# report that as SKIPPED rather than failing the run.
#
# Secrets live only in .env, which is git-ignored. Never commit it.
# ===========================================================================

# --- compose project -------------------------------------------------------
# Pinned so this stack never adopts/destroys the original `erpnext-sandbox`
# or `frappe_docker-1` containers or volumes.
COMPOSE_PROJECT_NAME=comp_demo

# --- ERPNext ---------------------------------------------------------------
SITE_NAME=frontend
# Host port for the ERPNext UI/API -> http://localhost:<ERPNEXT_PORT>
ERPNEXT_PORT=8000
# Runs the stack out of the box. Change it for anything shared/public.
DB_ROOT_PASSWORD=admin
# URL Node-RED uses to reach the bench over the compose network. Do not change.
ERPNEXT_INTERNAL_URL=http://bench:8000
# ERPNext version branch to provision (version-16).
ERPNEXT_VERSION=16
# Administrator API token, generated during provisioning and injected into the
# Node-RED flow. Leave blank - the scripts mint it and write it back here.
ERPNEXT_API_TOKEN=

# --- Node-RED --------------------------------------------------------------
NODE_RED_PORT=1880
# Source flow export. Leave blank: up.ps1 resolves it to the vendored
# sandbox/node-red/source-flow.json inside this repo.
NODE_RED_SOURCE_FLOW=
FLOWS_PATH=

# --- ngrok (OPTIONAL - leave blank to run without a public tunnel) ---------
# Public webhooks from Shopify need this. Without it the local stack still
# works; webhook wiring is reported as SKIPPED.
# Get a token at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
NGROK_API_PORT=4040
# Pin the public URL, e.g. https://your-name.ngrok-free.dev
# Blank => a new random *.ngrok-free.dev domain each start.
NGROK_PUBLIC_URL=
NGROK_URL_FLAG=

# --- Shopify (OPTIONAL - leave blank to skip the bridge) -------------------
# Store host only, no https:// and no trailing slash.
SHOPIFY_STORE=
SHOPIFY_API_VERSION=2026-04
# Admin API token (shpat_...). 24 h lifetime; minted from the client
# credentials below and written back here on every setup run.
SHOPIFY_ACCESS_TOKEN=
# Shopify admin -> Settings -> Apps -> Develop apps -> your app -> credentials
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- Production planner (drag-and-drop scheduler) --------------------------
# Host port the planner UI/API is published on. The container always listens on
# 3000; this is only the browser-facing port.
SCHEDULER_PORT=3001
# Credentials for the dedicated planner user (planner@ai-fix.local), minted by
# sandbox/scripts/ai-fix-scheduler-token.py. Leave blank on first run.
SCHEDULER_ERPNEXT_API_KEY=
SCHEDULER_ERPNEXT_API_SECRET=

# --- Metabase (optional BI dashboard) -------------------------------------
METABASE_PORT=3005
METABASE_DB_USER=metabase_user
METABASE_DB_PASS=metabase_demo_2026
METABASE_ERPNEXT_DB=frontend
METABASE_ADMIN_EMAIL=admin@compdemo.local
METABASE_ADMIN_PASSWORD=compdemo2026
