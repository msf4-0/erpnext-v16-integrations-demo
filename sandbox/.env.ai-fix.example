# ===========================================================================
# ERPNEXT-AI-FIX ??? stack configuration
# ===========================================================================
# Loaded explicitly:  docker compose --env-file ./sandbox/.env.ai-fix ...
# (sandbox/up.ps1 passes it for you.)  Keep this file local ??? it holds secrets.
# ===========================================================================

# --- compose project -------------------------------------------------------
# Pinned so this stack never adopts/destroys the original `erpnext-sandbox`
# or `frappe_docker-1` containers or volumes.
COMPOSE_PROJECT_NAME=erpnext-ai-fix

# --- ERPNext ---------------------------------------------------------------
SITE_NAME=frontend
# Host port for the ERPNext UI/API. The link reported at the end is
# http://localhost:<ERPNEXT_PORT>.
ERPNEXT_PORT=8000
DB_ROOT_PASSWORD=__FILL_ME__
# URL Node-RED uses to reach the bench over the compose network.
ERPNEXT_INTERNAL_URL=http://bench:8000
# ERPNext version branch to provision (version-16).
ERPNEXT_VERSION=16
# Administrator API token, generated during provisioning and injected into the
# Node-RED flow. Leave EMPTY ??? up.ps1 fills it in on first successful run.
ERPNEXT_API_TOKEN=__FILL_ME__

# --- Node-RED --------------------------------------------------------------
NODE_RED_PORT=1880
# Source flow export (the file the operator downloaded).
NODE_RED_SOURCE_FLOW=F:\shopify_erpnext_integration.json

# --- ngrok -----------------------------------------------------------------
# Authtoken copied from the host's ngrok config.
NGROK_AUTHTOKEN=__FILL_ME__
NGROK_API_PORT=4040
# Pin the public URL. Left blank => a new random *.ngrok-free.dev domain each
# start (webhooks are re-pointed automatically either way, but a pinned domain
# is nicer). Set to e.g. https://your-name.ngrok-free.dev
NGROK_PUBLIC_URL=
# Derived: the --url flag passed to the ngrok agent ("" when not pinned).
NGROK_URL_FLAG=

# --- Shopify ---------------------------------------------------------------
# Store host (no scheme) and Admin API version used by the Node-RED flow.
SHOPIFY_STORE=4e1075.myshopify.com
SHOPIFY_API_VERSION=2026-04
# Admin API access token (shpat_...). The value baked into the downloaded flow
# export is two different, partially-empty tokens ??? a bug. Set the real one
# here and the builder rewrites every Shopify node to use it.
SHOPIFY_ACCESS_TOKEN=__FILL_ME__

# --- Production planner (drag-and-drop scheduler) ---------------------------
# Host port the planner UI/API is published on. The container always listens on
# 3000; this is only the browser-facing port.
SCHEDULER_PORT=3001
# API credentials for the dedicated planner user (planner@ai-fix.local), minted
# by sandbox/scripts/ai-fix-scheduler-token.py. The planner reaches ERPNext over
# the compose network as http://bench:8000, never as localhost.
SCHEDULER_ERPNEXT_API_KEY=__FILL_ME__
SCHEDULER_ERPNEXT_API_SECRET=__FILL_ME__

SHOPIFY_CLIENT_ID=__FILL_ME__
SHOPIFY_CLIENT_SECRET=__FILL_ME__
