# Copy to sandbox/.env and adjust as needed. All values are optional — the
# compose file and scripts have sane defaults. sandbox/.env is gitignored.
#
# Compose loads this automatically only when the compose command runs with the
# sandbox directory as its project directory. The canonical commands run from
# the workspace root, so pass it explicitly:
#   docker compose -p erpnext-sandbox --env-file ./sandbox/.env \
#     -f ./sandbox/docker-compose.yml up -d
# (Without --env-file, the compose defaults below still apply.)

# Default site name created inside the sandbox bench.
SITE_NAME=frontend

# Host port the sandbox is published on. Leave blank to let the installer probe
# for a free port (starting at 8001). The container-internal port is always 8000.
HOST_PORT=8001

# MariaDB root password used by the sandbox db service.
DB_ROOT_PASSWORD=admin

# OPTIONAL convenience default: a GitHub org/user to look under when the user
# names only an app (not a full repo URL). Leave blank to always ask.
# For per-app repo URLs, prefer the shared registry at ../APP-SOURCES.md.
# APP_ORG=
