cd /path/to/erpnextcomp_demo
cp .env.example .env && chmod 600 .env     # set DB_ROOT_PASSWORD, ERPNEXT_ADMIN_PASSWORD

docker build -f bake/bench.Dockerfile \
  --build-arg ERPNEXT_BASE=frappe/erpnext:v16.35.0 \
  -t comp_demo-bench:v16 .                 # 10–25 min, once

COMPOSE="docker compose -p comp_demo --env-file .env --env-file versions.env -f docker-compose.yml"

$COMPOSE up -d db redis-cache redis-queue
$COMPOSE exec -T db sh -lc 'MYSQL_PWD="$MARIADB_ROOT_PASSWORD" mariadb-admin ping -h 127.0.0.1 -uroot'
$COMPOSE run --rm seed                     # new-site + restore the demo dump (~5 min)
$COMPOSE up -d bench
$COMPOSE logs -f bench                     # expect: db-grant: re-asserted …@%, no asset-check MISSING