# ===========================================================================
# Shopify -> ERPNext (via Node-RED) integration configuration
# ===========================================================================
# Copy to `.env` next to setup-shopify-erpnext.ps1 and fill the blanks.
#
# Layering: the script first reads the BUILD's own env file
# (`..\.env`, i.e. F:\ERPNEXT\erpnextcomp_demo\.env) if it exists, then this
# file on top. So SHOPIFY_SHOP / SHOPIFY_CLIENT_ID / SHOPIFY_CLIENT_SECRET /
# NGROK_AUTHTOKEN / ERP_API_TOKEN are inherited from the build when left blank
# here - you only fill in what is genuinely missing.
#
# Never commit a filled-in .env. Values are masked in every log line.
# ===========================================================================

# --- Shopify -----------------------------------------------------------------
# Store host, no scheme. Inherited from the build's .env as SHOPIFY_STORE.
SHOPIFY_SHOP=4e1075.myshopify.com

# Dev Dashboard app -> Client credentials. Required to mint an Admin API token.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Admin API version used by the flow's URLs and by the Shopify Access record.
SHOPIFY_API_VERSION=2026-04

# --- Shopify token cache (written by the script, leave alone) ----------------
# The script caches the token it minted plus its expiry so a re-run can skip
# re-minting (and therefore skip restarting Node-RED). Delete both to force a
# fresh token, or use -ForceToken.
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_TOKEN_EXPIRES=

# --- ngrok -------------------------------------------------------------------
# Required only the first time, to run `ngrok config add-authtoken`.
NGROK_AUTHTOKEN=

# A reserved/static dev domain, e.g. xxxx.ngrok-free.dev (no scheme).
# Leave blank to accept whatever domain the agent is given - but then the
# webhook URLs change on every restart, which is why a static domain is
# strongly recommended (Shopify and ERPNext both cache the URL).
NGROK_DOMAIN=scoreless-barcode-length.ngrok-free.dev

# --- ERPNext -----------------------------------------------------------------
ERP_URL=http://localhost:8000

# How Node-RED reaches ERPNext. This matters:
#   * Node-RED on the HOST      -> same value as ERP_URL
#   * Node-RED in a container   -> the compose service name (e.g. http://bench:8000)
# Every ERPNext node URL in the flow is rewritten to this value, because
# `localhost` inside a container means the container itself.
ERP_INTERNAL_URL=http://bench:8000

ERP_ADMIN_USER=Administrator
ERP_ADMIN_PASSWORD=

# Pre-existing ERPNext API token as `api_key:api_secret`. If set and it
# authenticates, it is REUSED. If it is blank or rejected, the script generates
# a new pair - which invalidates the previous one - and saves it back here.
# In this build it is inherited from ..\.env (ERPNEXT_API_TOKEN).
ERP_API_TOKEN=

# Sent to Node-RED as the `X-Webhook-Secret` header on every ERPNext webhook.
# Generate one with:  -join ((1..32) | % { '{0:x}' -f (Get-Random -Max 16) })
WEBHOOK_SECRET=

# --- ERPNext master data -----------------------------------------------------
# These MUST be real record names in the site. The values below are the ones
# that actually exist in this build (company SHRDC); the generic v12 names
# (Selangor Human Resource Development Centre / Cimb Bank - SHRDC) do NOT
# exist here and would fail Link validation.
ERP_COMPANY=SHRDC
ERP_COST_CENTER=Main - SHRDC
ERP_CASH_BANK_ACCOUNT=Bank Accounts - SHRDC
ERP_BANK_ACCOUNT=Bank Accounts - SHRDC
ERP_WAREHOUSE=Stores - SHRDC
ERP_PRICE_LIST=Standard Selling
ERP_TAX_ACCOUNT=GST - SHRDC

# --- Flow --------------------------------------------------------------------
# Absolute path, or relative to this script's folder.
# This must be the BUILT flow (sandbox\node-red\flows.json), which already
# carries the fixes from sandbox\node-red\build-flows.py. Pointing this at the
# raw export (source-flow.json) also works, but then run build-flows.py first
# or the inventory-sync header bug comes back.
FLOW_JSON_PATH=..\sandbox\node-red\flows.json

# Node-RED Admin API. Unauthenticated in this build.
NODE_RED_URL=http://localhost:1880
NODE_RED_PORT=1880

# Container name, used only by the EBUSY fallback: when /data/flows.json is
# bind-mounted from Windows, Node-RED cannot atomically rename it, so the flow
# is written on the host and the container is restarted instead.
# Leave blank for a standalone (npm) Node-RED.
NODE_RED_CONTAINER=comp_demo-node-red-1

# Bench container, used to write Webhooks through the server-side document API
ERP_BENCH_CONTAINER=comp_demo-bench-1
